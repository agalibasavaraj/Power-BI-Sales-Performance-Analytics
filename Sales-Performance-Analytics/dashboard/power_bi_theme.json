{
  "name": "Corporate Slate & Indigo Analytics",
  "dataColors": [
    "#3B82F6",
    "#10B981",
    "#8B5CF6",
    "#F59E0B",
    "#06B6D4",
    "#EC4899",
    "#64748B",
    "#6366F1"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#3B82F6",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F8FAFC" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "angle": "bottomRight",
            "shadowBlur": 8,
            "shadowSpread": 1
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
